# ==========================================
# BARBOYA SUPERAPP - VARIABLES DE ENTORNO
# ==========================================

# URL Base de la API REST de FastAPI
# Desarrollo local (Nativo/Web): http://localhost:8010/api/v1
# Emulador Android: http://10.0.2.2:8010/api/v1
# Producción: https://api.barboya.com/api/v1
API_URL=http://localhost:8010/api/v1

# URL de WebSockets para telemetría y pedidos
# Desarrollo local: ws://localhost:8010/api/v1/ws
# Emulador Android: ws://10.0.2.2:8010/api/v1/ws
# Producción: wss://api.barboya.com/api/v1/ws
WS_URL=ws://localhost:8010/api/v1/ws

# Entorno: development | staging | production
ENVIRONMENT=development

# Claves públicas de proveedores (opcional según plataforma)
# MAPS_API_KEY=AIzaSy...
